{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent CV site content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "meta", "person", "home"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "ogDescription", "ogImageAlt"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "ogDescription": { "type": "string", "minLength": 1 },
        "ogImageAlt": { "type": "string", "minLength": 1 }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "jobTitle", "worksFor", "locality", "country", "knowsAbout"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "jobTitle": { "type": "string", "minLength": 1 },
        "worksFor": { "type": ["string", "null"], "minLength": 1 },
        "locality": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "knowsAbout": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "heading", "deck", "starters", "summary", "proof", "work", "followups"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "heading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first", "second"],
          "properties": { "first": { "type": "string", "minLength": 1 }, "second": { "type": "string", "minLength": 1 } }
        },
        "deck": { "type": "string", "minLength": 1 },
        "starters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "prompt", "href"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "pattern": "^(https://[^/\\s]|/(?!/)|#)\\S*$" }
            }
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "proof": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text", "href"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "pattern": "^(https://[^/\\s]|/(?!/)|#)\\S*$" }
            }
          }
        },
        "work": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text", "href"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "pattern": "^(https://[^/\\s]|/(?!/)|#)\\S*$" }
            }
          }
        },
        "followups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "prompt"],
            "properties": { "label": { "type": "string", "minLength": 1 }, "prompt": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
