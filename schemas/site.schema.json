{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent CV site content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
